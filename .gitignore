# Secrets — never commit
.env
.env.*
!.env.example
*.key

# Third-party COPYRIGHTED source PDFs & PRIVATE materials — must never be published
data/
documents/
transcript-meetings/

# Per-run regenerable artifacts (curated top-level reports in outputs/ are kept)
outputs/runs/
outputs/lkg/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Project outputs (regenerable) — keep source, ignore heavy generated artifacts
outputs/**/graphrag_data/
*.parquet
*.log

# Windows-migration debris (2026-09-30 machine move): the migration wrote dotless
# copies of the dotfiles. `env/` above has a trailing slash, so it matches a
# DIRECTORY named env and never matched the stray `env` FILE — which held a live
# OpenAI key in a public repository. Named without a slash here so it cannot recur.
/env
/env.example
/gitignore
PROJECT_BACKUP_*/
*.exe

# Claude Code machine-local settings (permissions differ per machine)
.claude/settings.local.json
