# Secrets — never commit
.env
.env.*
!.env.example
*.key

# Third-party COPYRIGHTED source PDFs & PRIVATE materials — must never be published
data/
data-emotion/
documents/
transcript-meetings/
# `data-emotion/` follows `data/`: it holds a searched corpus definition and will hold
# downloaded full texts. The search stays reproducible without it, because the queries
# live in `config-emotion/protocol.yaml`, the per-query record lives in the `search_log`
# table, and `scripts/run_protocol_search.py` regenerates the pool from the protocol.
# `outputs-emotion/SEARCH_REPORT.md` is a curated top-level report and IS committed.

# Per-run regenerable artifacts (curated top-level reports in outputs/ are kept)
outputs/runs/
outputs/lkg/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Project outputs (regenerable) — keep source, ignore heavy generated artifacts
outputs/**/graphrag_data/
*.parquet
*.log

# Windows-migration debris (2026-09-30 machine move): the migration wrote dotless
# copies of the dotfiles. `env/` above has a trailing slash, so it matches a
# DIRECTORY named env and never matched the stray `env` FILE — which held a live
# OpenAI key in a public repository. Named without a slash here so it cannot recur.
/env
/env.example
/gitignore
PROJECT_BACKUP_*/
*.exe

# Claude Code machine-local settings (permissions differ per machine)
.claude/settings.local.json
