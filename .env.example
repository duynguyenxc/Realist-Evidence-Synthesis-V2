# Copy to .env and fill in real values. NEVER commit .env.
OPENAI_API_KEY=sk-your-key-here
# Optional (multi-LLM ensemble, decided later):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Review isolation (added 2026-11-02) ----------------------------------
# Richmond's corpus, gold standard and PUBLISHED outputs live at the defaults.
# A second review on a new topic must be pointed elsewhere, or `res export-results`
# will overwrite outputs/RESULTS.html — the artefact of record. Relative values
# resolve against the project root. `res status` prints what is actually active.
#
# RES_CONFIG_DIR=config-emotion
# RES_DATA_DIR=data-emotion
# RES_OUTPUTS_DIR=outputs-emotion
# POSTGRES_DB=emotion_synthesis
